# James Blog — Environment Variables
# Copy to .env and fill in your values.

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fastapi_platform

# Application
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="FastAPI Platform"

# CORS
CORS_ORIGINS=["http://localhost:8000","http://localhost:8500","http://127.0.0.1:8000"]

# PostgreSQL (for docker-compose)
POSTGRES_PASSWORD=postgres

# Uploads
MAX_UPLOAD_SIZE=10485760
